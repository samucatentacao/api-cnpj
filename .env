# ─── Servidor ─────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Backends de persistência ─────────────────────────────────────────────────
# Lista separada por vírgula. O PRIMEIRO é o primário (usado para leituras).
# Todos os backends listados recebem escritas em paralelo (fan-out).
#
# Exemplos:
#   DB_BACKENDS=postgres              → apenas Postgres
#   DB_BACKENDS=mongodb               → apenas MongoDB
#   DB_BACKENDS=postgres,mongodb      → Postgres primário + MongoDB espelho
#   DB_BACKENDS=mongodb,postgres      → MongoDB primário + Postgres espelho
DB_BACKENDS=postgres,mongodb

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_URL="postgres://postgres:P1BcHoUetzSChgQxQVSRgm1BgokGMMxUeW5jgNxl3Hkj52RSlv4H8H81qzXORLrU@64.20.37.194:5432/dataws_db?sslmode=disable"

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB=dataws

# ─── Redis (cache — opcional, sobe sem ele) ───────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
